# mhtran-dash environment variables
# Copy to .env and fill in values before running.
# Never commit .env — it is gitignored.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=mhtran
POSTGRES_DB=mhtran

# -- SET A STRONG PASSWORD --
POSTGRES_PASSWORD=

# ── Web / Nginx (production) ─────────────────────────────────────────────────
# Host + port exposed by the web container on the Proxmox VM.
# The Proxmox reverse proxy points at this.
MHTRAN_HOST=127.0.0.1
MHTRAN_PORT=8036
